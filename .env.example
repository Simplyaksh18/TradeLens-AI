# Root .env for `docker compose` variable substitution (compose.yaml).
# Copy to .env and fill in; never commit the real file.
#
# This is NOT copied into any Docker image — Compose reads it only on the
# host when resolving ${VAR} references in compose.yaml.

# Public Google OAuth client ID (same one used natively in
# backend/.env / frontend/.env) — safe to expose to the browser, not a
# secret. Used for both the backend's GOOGLE_CLIENT_ID verification and the
# frontend's VITE_GOOGLE_CLIENT_ID build arg.
GOOGLE_CLIENT_ID=

# Optional overrides — leave unset to use compose.yaml's defaults.
# DATABASE_URL=
# ENVIRONMENT=
# BACKEND_PORT=8000
# FRONTEND_PORT=5173
# VITE_API_BASE_URL=http://localhost:5173
