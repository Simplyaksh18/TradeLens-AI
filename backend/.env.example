DATABASE_URL=postgresql+psycopg://tradelens:CHANGE_ME@localhost:5432/tradelens
ENVIRONMENT=development
SESSION_COOKIE_NAME=tradelens_session
SESSION_TTL_DAYS=14

# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# This is a public identifier, safe to also put in the frontend's VITE_GOOGLE_CLIENT_ID.
# Do NOT put a Google client SECRET here or anywhere in this project.
GOOGLE_CLIENT_ID=

# Phase 5B -- SERVER-SIDE ONLY SECRET. Never put this in frontend/.env or
# any VITE_* variable, never commit the real value, never log/print it.
# From https://console.groq.com/keys. Only required to run
# backend/scripts/phase5a_manual_verification.py's Groq calls or any
# future endpoint that actually invokes GroqResearchLanguageModel --
# the entire deterministic test suite runs without this set.
GROQ_API_KEY=

# Optional -- defaults to openai/gpt-oss-120b if unset (see
# app/core/config.py; verified against this account's actual available
# Groq models -- Groq's catalog changes over time, so override here
# rather than editing code if the default ever stops being available).
GROQ_MODEL=

# Post-Phase-5F hardening -- Phase 5A knowledge retrieval embedding
# provider. "semantic" (default) uses a real local embedding model
# (fastembed/ONNX, no PyTorch, no Groq); "lexical" opts back into the
# original deterministic LocalHashEmbeddingProvider. Never silently
# falls back -- an unrecognized value or a failed "semantic" model load
# is a startup error.
RESEARCH_EMBEDDING_PROVIDER=semantic

# Optional -- where the semantic embedding model is downloaded to once
# and cached (defaults under <project_root>/data/embedding_model_cache,
# the same bind-mounted data/ directory Docker already persists).
EMBEDDING_MODEL_CACHE_DIR=
